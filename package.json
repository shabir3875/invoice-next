{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "concurrently --kill-others --raw \"npm run start --prefix apps/web\"",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "fill-range": "^7.1.1",
    "knip": "^6.32.1",
    "tailwindcss": "^3.4.17"
  },
  "workspaces": [
    "apps/*",
    "tools/safe-braces"
  ],
  "overrides": {
    "brace-expansion": "^1.1.21",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.7",
    "smol-toml": "^1.9.0",
    "baseline-browser-mapping": "^2.11.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
