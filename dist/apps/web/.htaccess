<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  ErrorDocument 404 /404.html
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.invonxt\.com$ [NC]
  RewriteRule ^ https://invonxt.com%{REQUEST_URI} [R=301,L]
  RewriteRule ^template/freeluncer/?$ /templates/freelance [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

